# Copie para /etc/hub-env/remote-hub.env (chmod 600). Nunca versionar o arquivo real.

# Borda via Tailscale (Cloudflare desligado). Operadores usam login/senha (accounts.json);
# agentes continuam com id + segredo proprios. Sem CF_ACCESS_* neste modo.
EDGE_AUTH=tailscale
TAILSCALE_HOSTS=servidor.tail074692.ts.net:8787
LAN_OPERATOR_URL=
# Modo antigo (Cloudflare Access): remova EDGE_AUTH e defina
# CF_ACCESS_TEAM_DOMAIN=SEUTIME.cloudflareaccess.com
# CF_ACCESS_AUD=<Application Audience (AUD) Tag>
# Quem administra (criar/remover maquinas, mudar configuracoes). Vazio = todos os operadores.
ADMIN_EMAILS=thiagomtek@gmail.com

# Relay local opcional (Caddy -> hub). O navegador ainda precisa do ticket efemero emitido apos
# autenticar pelo Cloudflare Access; a rota LAN nao cria um segundo login.
LAN_HUB_HOST=hub-int.tththiago.com.br
LAN_OPERATOR_URL=wss://hub-int.tththiago.com.br/operator

# TURN (coturn). Segredo: openssl rand -hex 32
# turn.tththiago.com.br = CNAME para o DDNS, "DNS only" (nuvem cinza).
TURN_URLS=turn:turn.tththiago.com.br:3478?transport=udp,turn:turn.tththiago.com.br:3478?transport=tcp
TURN_SECRET=
TURN_REALM=tththiago.com.br
TURN_DDNS_HOST=servidorcasamr.tplinkdns.com
# IP da VM na rede do VirtualBox (ver com: ip -4 addr). O arquiteto indicou 10.0.2.15.
TURN_PRIVATE_IP=10.0.2.15
